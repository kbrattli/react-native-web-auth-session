{
  "name": "react-native-web-auth-session",
  "version": "0.1.0",
  "description": "Open a URL in the system auth browser (ASWebAuthenticationSession, Android Auth Tab) and get the callback URL back",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-web-auth-session-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-web-auth-session-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "test": "jest",
    "prepublishOnly": "npm run typecheck && npm test",
    "postversion": "npm publish && git push --follow-tags"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "oauth",
    "auth-tab",
    "custom-tabs",
    "ASWebAuthenticationSession",
    "web-auth-session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbrattli/react-native-web-auth-session.git"
  },
  "author": "Kenneth Brattli (https://github.com/kbrattli)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kbrattli/react-native-web-auth-session/issues"
  },
  "homepage": "https://github.com/kbrattli/react-native-web-auth-session#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@types/react": "^19.2.0",
    "del-cli": "^8.0.1",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.44.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "WebAuthSessionSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.webauthsession"
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "react-native-web-auth-session-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  }
}
